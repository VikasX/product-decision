# Local MongoDB, or replace with your Atlas mongodb+srv:// connection string.
MONGODB_URI=mongodb://localhost:27017/
# Database for health checks and, when enabled, shared analysis/cache/budget state.
MONGODB_DATABASE=product_reviews
# Bound database waits so connection failures do not hang API requests.
MONGODB_TIMEOUT_MS=5000
# Extra exact frontend origins as JSON; built-in local/production origins are added in main.py.
CORS_ORIGINS=[]
LOG_LEVEL=INFO
# Public catalog serves analysis.json only and never creates an LLM service/budget store.
# false is for private local development only; Vercel still blocks generation routes.
PUBLIC_SAVED_REPORTS_ONLY=true
# Server-only key belongs in ignored .env or deployment settings; never commit its value.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
# Completion allowance includes reasoning; the serialized prompt has a separate input bound.
OPENAI_MAX_OUTPUT_TOKENS=2000
OPENAI_MAX_INPUT_TOKENS=40000
# Conservative app reservation caps, not the OpenAI account balance; daily reset is Asia/Calcutta.
AI_DAILY_BUDGET_USD=0.02
AI_LIFETIME_BUDGET_USD=0.10
AI_MAX_PAID_ATTEMPTS_PER_DAY=20
# Active flow retains at most eight accessible product-page reviews, including negative evidence.
AMAZON_MAX_REVIEWS=8
# Legacy compatibility setting; current collection requests only the main product page.
AMAZON_MAX_PAGES=7
AMAZON_TIMEOUT_SECONDS=10
# Retry transport/transient server errors only; never CAPTCHA or sign-in restrictions.
AMAZON_TRANSIENT_RETRIES=1
# Local backend opt-in; the endpoint is still denied on Vercel and to non-loopback clients.
LANGCHAIN_LAB_ENABLED=false
# auto uses SQLite locally and shared MongoDB on Vercel. Vercel always requires MongoDB.
AI_STATE_BACKEND=auto
# Optional absolute SQLite path; defaults to backend/.data/analysis.sqlite3.
# AI_STATE_PATH=

# UTF-8 byte cap for compact source JSON shared by both LLM adapters.
ANALYSIS_EVIDENCE_MAX_BYTES=10000
